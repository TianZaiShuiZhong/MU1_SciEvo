{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/scievo.schema.json",
  "title": "SciEvoRecord",
  "type": "object",
  "required": [
    "record_id",
    "track_type",
    "domain",
    "source",
    "initial_request",
    "trajectory",
    "success_verification",
    "provenance"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{6,128}$"
    },
    "track_type": {
      "const": "Sci-Evo"
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "format": "uri" },
        "doi": { "type": "string" },
        "license": { "type": "string" },
        "citation": { "type": "string" }
      },
      "additionalProperties": true
    },
    "initial_request": {
      "type": "object",
      "required": ["target_name", "input_data", "user_intent", "quantifiable_goal"],
      "properties": {
        "target_name": { "type": "string" },
        "input_data": { "type": "string" },
        "user_intent": { "type": "string" },
        "quantifiable_goal": { "type": "string" }
      },
      "additionalProperties": true
    },
    "trajectory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_index", "thought", "action", "tool", "observation", "outcome"],
        "properties": {
          "step_index": { "type": "integer", "minimum": 1 },
          "thought": { "type": "string" },
          "action": { "type": "string" },
          "tool": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" }
            },
            "additionalProperties": true
          },
          "parameters": { "type": "object" },
          "observation": { "type": "string" },
          "outcome": {
            "type": "string",
            "enum": ["success", "partial", "failure"]
          },
          "reasoning_tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "success_verification": {
      "type": "object",
      "required": ["validation_technique", "metrics", "final_verdict"],
      "properties": {
        "validation_technique": { "type": "string" },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "value", "unit", "interpretation"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": "string" },
              "unit": { "type": "string" },
              "interpretation": { "type": "string" }
            }
          }
        },
        "final_verdict": { "type": "string" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["created_at", "pipeline_version", "mineru"],
      "properties": {
        "created_at": { "type": "string" },
        "pipeline_version": { "type": "string" },
        "mineru": {
          "type": "object",
          "required": ["used"],
          "properties": {
            "used": { "type": "boolean" },
            "mode": { "type": "string" },
            "task_id": { "type": "string" },
            "model_version": { "type": "string" }
          },
          "additionalProperties": true
        },
        "source_span": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "properties": {
        "review_status": {
          "type": "string",
          "enum": ["draft", "reviewed", "approved"]
        },
        "traceability_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness_score": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

